# Sovereign CPA Engine — Environment Configuration
# Copy this file to .env and fill in your values
# WARNING: Never commit .env to version control
#
# Required for production: DATABASE_URL, JWT_SECRET, CERT_SIGNING_PRIVATE_KEY, CERT_SIGNING_PUBLIC_KEY
# Required for AI features: ANTHROPIC_API_KEY
# Everything else has sensible defaults

# ─── Server ───────────────────────────────────────────────────────────────────
# Port the API server listens on.
PORT=3000
# development | production
NODE_ENV=development
# Runtime mode: dev | demo | prod. Controls auth enforcement, demo seeding, and key requirements.
# dev = optional auth, dev tools enabled. demo = auth enforced, demo user seeded. prod = strict, all keys required.
MODE=dev
# Set to 1 when behind a reverse proxy (nginx, ALB) so rate limiter uses X-Forwarded-For.
# TRUST_PROXY=0
# Allowed CORS origins. Comma-separated for multiple, or single origin.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
# CORS_ORIGIN=http://localhost:3002

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string for the control database (required).
DATABASE_URL=postgresql://sovereign:sovereign_dev@localhost:5432/sovereign_engine
# Optional: separate URL for tenant migrations only (else DATABASE_URL is used).
# MIGRATE_TENANT_URL=
# AI boundary: when true, two DB roles per tenant (core_writer + ai_writer) enforce schema isolation.
# AI_BOUNDARY_DB_ROLES=false
# AI-scoped DB credentials (used when AI_BOUNDARY_DB_ROLES=true).
# AI_DB_USER=ai_writer
# AI_DB_PASSWORD=
# Optional: explicit AI connection URL (overrides AI_DB_USER/AI_DB_PASSWORD construction).
# DATABASE_AI_URL=
# Set to true to allow db:reset script (NEVER in production).
# ALLOW_DB_RESET=false

# ─── Authentication ───────────────────────────────────────────────────────────
# JWT signing secret (required in production — use a strong random value, minimum 32 chars).
JWT_SECRET=
# JWT token expiry (default: 24h). Examples: 7d, 1h, 30m.
# JWT_EXPIRES_IN=24h
# Set to false only in MODE=dev to allow optional auth (always true in demo/prod).
# REQUIRE_AUTH=true
# Set to true to require tenant context on every request (disables in-memory fallback).
# REQUIRE_TENANT_CONTEXT=false
# Set to 1 to allow same user to create and approve journal entries (single-user/dev mode).
# WARNING: Must be 0 in production for SOX segregation of duties.
# ALLOW_SAME_USER_APPROVE=0
# Token for external auditor portal access.
# AUDITOR_PORTAL_TOKEN=

# ─── Cryptographic Signing (Ed25519) ─────────────────────────────────────────
# Ed25519 keys for certification artifact signing.
# In development: auto-generated if not set (ephemeral, change on restart).
# In production: REQUIRED — startup fails without them.
# Generate with: npm run keygen
# Values are base64-encoded DER (PKCS#8 private, SPKI public).
# CERT_SIGNING_PRIVATE_KEY=
# CERT_SIGNING_PUBLIC_KEY=

# ─── AI / LLM ────────────────────────────────────────────────────────────────
# LLM provider: anthropic | openai | mistral. Default: anthropic.
# LLM_PROVIDER=anthropic
# AI model identifier (e.g. claude-sonnet-4-20250514).
# AI_MODEL=
# API keys (only the provider you're using is required).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# MISTRAL_API_KEY=
# AI request timeout in milliseconds (default: 30000).
# AI_TIMEOUT_MS=30000
# Mock AI responses (for testing without LLM calls). Set to true to enable.
# AI_MOCK=false
# AI_MOCK_ADVISOR=false
# AI_MOCK_CLASSIFIER=false
# Shadow audit AI configuration.
# AI_SHADOW_FINDINGS_JSON=
# AI_SHADOW_SEVERITY=

# ─── Storage ──────────────────────────────────────────────────────────────────
# Storage adapter: local | s3. Default: local.
# STORAGE_ADAPTER=local
# Base path for local disk storage (attachments, export packages). Default: ./storage.
# STORAGE_LOCAL_BASE_PATH=./storage
# Evidence file storage path. Default: ./data/evidence.
# EVIDENCE_STORAGE_PATH=./data/evidence
# S3 configuration (when STORAGE_ADAPTER=s3).
# EVIDENCE_S3_BUCKET=
# EVIDENCE_S3_PREFIX=evidence/
# EVIDENCE_S3_REGION=us-east-1
# Max evidence attachment size in bytes (default: 10MB).
# EVIDENCE_ATTACHMENT_MAX_BYTES=10485760
# Allowed MIME types for attachments (comma-separated). Default: application/pdf,image/png,image/jpeg.
# SECURITY_ATTACHMENT_MIME_WHITELIST=application/pdf,image/png,image/jpeg

# ─── Job Worker ───────────────────────────────────────────────────────────────
# Enable background job worker (processes async tasks like statement generation).
# JOB_WORKER_ENABLED=true
# Poll interval in milliseconds.
# JOB_WORKER_POLL_MS=5000
# Backoff base for failed job retries.
# JOB_WORKER_BACKOFF_BASE_MS=1000

# ─── Feature Flags & Guards ──────────────────────────────────────────────────
# Enable CPA-specific features.
# CPA_ENABLED=true
# Enable dev diagnostics API routes (never in production).
# ENABLE_DEV_API=false
# Enable GL post-back to external general ledger (disabled by default for pilot).
# ENABLE_GL_POSTBACK=false
# Enable integrated supervisor mode.
# ENABLE_INTEGRATED_SUPERVISOR=false
# Allow exporting draft adjustments that don't balance (dev only).
# ALLOW_IMBALANCED_DRAFT_EXPORT=false
# Allow legacy certified source format.
# ALLOW_LEGACY_CERTIFIED_SOURCE=false
# Require DB context for audit log (no in-memory fallback).
# REQUIRE_AUDIT_DB_CONTEXT=false
# Trial balance row limit (default 100000). Reject ingest with 413 when exceeded.
# MAX_TB_ROWS=100000
# Audit log retention in years (default: 7).
# AUDIT_LOG_RETENTION_YEARS=7
# Path to financial_rules.json (default: shared/config/financial_rules.json).
# RULES_CONFIG_PATH=

# ─── Integrations (optional) ─────────────────────────────────────────────────
# Google OAuth (for Gmail/Drive ingestion).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=
# GOOGLE_OAUTH_SCOPES=
# Gmail ingestion.
# GMAIL_ACCESS_TOKEN=
# GMAIL_QUERY=
# GMAIL_MAX_RESULTS=
# Google Drive.
# GOOGLE_DRIVE_ACCESS_TOKEN=
# GOOGLE_DRIVE_FOLDER_ID=
# Integration store encryption key.
# INTEGRATION_STORE_KEY=
# Ingestion scheduler.
# INGESTION_SCHEDULER_ENABLED=false
# INGESTION_SCHEDULER_INTERVAL_MS=
# INGESTION_FETCH_THROTTLE_MS=
# INGESTION_DEDUP_KEY=
# FETCHER_RUNS_PER_DAY=
# OCR service URL (AWS Textract, Google Document AI, or Tesseract-based).
# OCR_SERVICE_URL=
# Supabase (if using Supabase-hosted Postgres).
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# E2B sandbox API key.
# E2B_API_KEY=
# Seed test data on startup (for CI/testing only).
# SEED_FOR_TESTS=false
