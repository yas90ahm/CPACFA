# FinOS — Environment variables template
# Copy this file to .env and fill in your values.
# Never commit .env to Git.

# --- Production / persistence ---
# Postgres control DB URL (required for persistence). For Supabase, use the Postgres connection string from Dashboard → Settings → Database.
# Same URL is used for tenant migrations when you run: npx tsx src/db/migrate.ts --tenant
DATABASE_URL=
# Optional: override for tenant migrations only (else DATABASE_URL is used).
# MIGRATE_TENANT_URL=
# Required in production; never use dev default.
JWT_SECRET=
# Optional; default 24h (e.g. 7d, 1h).
JWT_EXPIRES_IN=
# development | production
NODE_ENV=
# APP_MODE: development | demo | production. Default: development.
# development: REQUIRE_AUTH can be false, dev tools enabled.
# demo: Auth ALWAYS enforced, demo user seeded (demo@cpacfa.com / demo-password-change-me).
# production: Auth ALWAYS enforced, no demo user, JWT_SECRET and Ed25519 keys required.
# APP_MODE=
# Legacy: MODE = dev | demo | prod (APP_MODE takes precedence).
MODE=
# Set to false only in MODE=dev to allow optional auth.
REQUIRE_AUTH=
# Set to true to disable in-memory tenant fallbacks.
REQUIRE_TENANT_CONTEXT=
# Set to 1 or true to require DB context for audit log (no in-memory-only).
# REQUIRE_AUDIT_DB_CONTEXT=
# Storage: base path for local disk adapter (attachments, export packages). Default: ./storage.
# STORAGE_LOCAL_BASE_PATH=
# Allowed origins (comma-separated for CORS_ORIGINS).
CORS_ORIGIN=
# CORS_ORIGINS=
# Optional; default 3000. Server listens on this port.
PORT=3000
# Optional; default 7 (years). Audit log retention purge cutoff.
AUDIT_LOG_RETENTION_YEARS=
# Journal Entry segregation: set to 1 or true to allow same user to approve JEs they created (single-user mode).
# ALLOW_SAME_USER_APPROVE=
# Pilot production: GL post-back disabled by default. Set to true to allow pushing close adjustments to external GL.
# ENABLE_GL_POSTBACK=
# Trial balance row limit (default 100000). Reject ingest with 413 when exceeded.
# MAX_TB_ROWS=

# --- LLM / integrations ---
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
E2B_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
GMAIL_ACCESS_TOKEN=
GMAIL_QUERY=
GMAIL_MAX_RESULTS=
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_SCOPES=
INTEGRATION_STORE_KEY=
INGESTION_DEDUP_KEY=
INGESTION_SCHEDULER_ENABLED=
INGESTION_SCHEDULER_INTERVAL_MS=
INGESTION_FETCH_THROTTLE_MS=
FETCHER_RUNS_PER_DAY=

# --- OCR (direct cloud / service) ---
# Set OCR_SERVICE_URL to your OCR endpoint (e.g. AWS Textract, Google Document AI, or Tesseract-based service).
# OCR_SERVICE_URL=

# --- Ed25519 certification signing ---
# Required in production. In development, keys are auto-generated if not set.
# Run: npm run keygen to generate persistent keys.
# CERT_SIGNING_PRIVATE_KEY=
# CERT_SIGNING_PUBLIC_KEY=

# --- Deprecated (do not use; Python backend removed) ---
# BACKEND_PYTHON_URL, PYTHON_MATH_BASE, PYTHON_OCR_URL — removed.
