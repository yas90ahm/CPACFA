# UAT environment — safe defaults. Copy to uat/.env or source before running UAT.
# The UAT runner refuses to run if ALLOW_DB_RESET=true.

# Required: non-production database (no "prod" in URL).
DATABASE_URL=

# Optional; default dev secret. Production must set a real secret.
JWT_SECRET=

# Safe for UAT/staging: destructive flags OFF.
NODE_ENV=staging
ALLOW_DB_RESET=false
SEED_FOR_TESTS=false

# Optional: AI mock controls (runner sets these for shadow-block test; no need here).
# AI_MOCK=
# AI_SHADOW_SEVERITY=
