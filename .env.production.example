# Sovereign CPA Engine — Production Environment
# Copy to .env.production or set via secrets management (AWS Secrets Manager, Vault, etc.)
#
# CRITICAL: All values marked [SECRET] must be set via secrets management, NOT in files.
# CRITICAL: Never commit this file with real values.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
MODE=prod
TRUST_PROXY=1
CORS_ORIGINS=https://your-app-domain.com

# ─── Database [SECRET] ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://sovereign_prod:CHANGE_ME@your-db-host:5432/sovereign_engine?sslmode=require
# AI_BOUNDARY_DB_ROLES=true
# AI_DB_USER=ai_writer
# AI_DB_PASSWORD=CHANGE_ME

# ─── Authentication [SECRET] ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_SECRETS_MANAGER
JWT_EXPIRES_IN=24h
REQUIRE_AUTH=true
REQUIRE_TENANT_CONTEXT=true
# SOX compliance: MUST be 0 in production
ALLOW_SAME_USER_APPROVE=0

# ─── Cryptographic Signing [SECRET] ──────────────────────────────────────────
# Generate with: npm run keygen
# REQUIRED in production — startup will fail without these.
CERT_SIGNING_PRIVATE_KEY=CHANGE_ME_USE_SECRETS_MANAGER
CERT_SIGNING_PUBLIC_KEY=CHANGE_ME_USE_SECRETS_MANAGER

# ─── AI / LLM [SECRET] ──────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=CHANGE_ME_USE_SECRETS_MANAGER
AI_TIMEOUT_MS=30000
AI_MOCK=false

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_ADAPTER=local
EVIDENCE_STORAGE_PATH=/app/data/evidence
# For S3:
# STORAGE_ADAPTER=s3
# EVIDENCE_S3_BUCKET=your-evidence-bucket
# EVIDENCE_S3_PREFIX=evidence/
# EVIDENCE_S3_REGION=us-east-1

# ─── Job Worker ───────────────────────────────────────────────────────────────
JOB_WORKER_ENABLED=true

# ─── Production Guards ───────────────────────────────────────────────────────
ALLOW_DB_RESET=false
ENABLE_DEV_API=false
ENABLE_GL_POSTBACK=false
ALLOW_IMBALANCED_DRAFT_EXPORT=false
REQUIRE_AUDIT_DB_CONTEXT=true
AUDIT_LOG_RETENTION_YEARS=7
