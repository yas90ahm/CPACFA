{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "roots": ["<rootDir>"],
  "testMatch": ["**/smoke/**/*.test.ts"],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transform": {
    "^.+\\.tsx?$": ["ts-jest", { "useESM": true, "isolatedModules": true }]
  },
  "extensionsToTreatAsEsm": [".ts"],
  "setupFilesAfterEnv": []
}
